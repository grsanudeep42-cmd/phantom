# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Set ONE of these (or none — Ollama local works without any key):

ANTHROPIC_API_KEY=sk-ant-...         # Claude models
OPENAI_API_KEY=sk-...                # GPT-4o, GPT-4-turbo, etc.
OPENROUTER_API_KEY=sk-or-...         # 200+ models via openrouter.ai

# Optional: override provider selection
# LLM_PROVIDER=ollama                # anthropic | openai | ollama | openrouter | custom
# LLM_MODEL=llama3.1                 # model name for the selected provider
# LLM_BASE_URL=http://localhost:11434/v1   # Ollama or any OpenAI-compat endpoint
# LLM_API_KEY=                       # generic key override

# ─── Optional enrichment ───────────────────────────────────────────────────────
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=

# ─── Identity layer (SMS OTP) ─────────────────────────────────────────────────
SMSPOOL_API_KEY=
TEXTVERIFIED_API_KEY=

# ─── Self-hosted email (leave blank to use Guerrilla Mail fallback) ────────────
PHANTOM_EMAIL_DOMAIN=
PHANTOM_EMAIL_PORT=2525

# ─── Tool + data paths ────────────────────────────────────────────────────────
PHANTOM_DATA_DIR=~/.phantom
PHANTOM_DOCKER_MODE=true
