# Required
ANTHROPIC_API_KEY=sk-ant-...

# Identity — SMS (configure ONE)
SMSPOOL_API_KEY=
TEXTVERIFIED_API_KEY=

# Optional — enhances OSINT
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=

# Optional — self-hosted email (leave blank to use Guerrilla Mail fallback)
# You need to own this domain and set MX record to your server IP
PHANTOM_EMAIL_DOMAIN=
PHANTOM_EMAIL_PORT=2525

# Optional — tool/data directories (defaults shown)
PHANTOM_DATA_DIR=~/.phantom
PHANTOM_DOCKER_MODE=true
